# Same-origin OpenAI-compatible image API proxy.
# VITE_* values are read at frontend build time.
VITE_API_PROXY_AVAILABLE=false
VITE_API_PROXY_LOCKED=false
VITE_API_PROXY_PREFIX=/api-proxy
# Optional server-only shared secret for the two proxies (workers/api-proxy.js +
# api/proxy.js). Requests must then carry x-taostudio-proxy-token. Intended for
# script/API callers (e.g. .omx smoke tests); browsers CANNOT hold a secret —
# anything VITE_-inlined ships in the public bundle — so enabling this token
# locks the proxy against browser use. Server-side credential injection
# (IMAGE_API_PROXY_AUTHORIZATION) is only honored for token-authenticated
# callers and is NEVER attached to anonymous traffic.
IMAGE_API_PROXY_TOKEN=
# Comma-separated extra origins allowed by proxy CORS reflection (defaults:
# https://image.taostudioai.com plus localhost/127.0.0.1 dev origins on any port).
IMAGE_API_PROXY_ALLOWED_ORIGINS=
IMAGE_API_PROXY_TARGET=https://your-gateway.example.com/v1
IMAGE_API_PROXY_ALLOWED_HOSTS=your-gateway.example.com
# Set to true to let the proxy accept any public HTTPS OpenAI-compatible API target
# sent by the browser through x-taostudio-api-base-url. Local/private targets are
# still rejected; use local development for http://127.0.0.1 or localhost services.
# Keep false in production: true turns the proxy into an open relay.
IMAGE_API_PROXY_ALLOW_PUBLIC_TARGETS=false

# Optional local-only OpenAI-compatible image API smoke test settings.
# Never commit real keys.
IMAGE_API_BASE_URL=https://your-gateway.example.com/v1
IMAGE_API_KEY=
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_TEST_API_MODE=images
IMAGE_API_TEST_SIZE=1024x1024
IMAGE_API_TEST_CODEX_CLI=true
IMAGE_API_TEST_MODERATION=auto
IMAGE_API_TEST_TIMEOUT_MS=600000
# Optional local Image Task API. Keep the token in .env.local only.
VITE_IMAGE_TASK_API_URL=
VITE_IMAGE_TASK_API_TOKEN=
IMAGE_TASK_API_PORT=9789
IMAGE_TASK_API_TOKEN=
IMAGE_TASK_API_CONCURRENCY=1
IMAGE_TASK_API_PROVIDER_TIMEOUT_MS=300000
IMAGE_TASK_API_PROVIDER_RETRY_BASE_MS=15000
IMAGE_TASK_API_ALLOWED_ORIGINS=
IMAGE_TASK_PROVIDER_BASE_URL=
IMAGE_TASK_PROVIDER_API_KEY=
IMAGE_TASK_PROVIDER_MODEL=gpt-image-2

# Optional manifest-driven batch runner (npm run batch:manifest).
# All paths are resolved relative to the repo root unless absolute.
# Required when running the manifest batch runner; harmless otherwise.
IMAGE_BATCH_KEY=image-manifest-batch
IMAGE_BATCH_NAME=
IMAGE_BATCH_OUTPUT_ROOT=
IMAGE_BATCH_MANIFEST_PATH=
IMAGE_BATCH_STATUS_PATH=
IMAGE_BATCH_WORK_DIR=
IMAGE_BATCH_RUNNER_CONCURRENCY=1
IMAGE_BATCH_PRIMARY_MODEL=gpt-image-2
IMAGE_BATCH_PRIMARY_API_MODE=images
IMAGE_BATCH_REVISION_MODEL=gpt-5.6-sol
IMAGE_BATCH_REVISION_API_MODE=responses
IMAGE_BATCH_CLIENT_NAME=
IMAGE_BATCH_CONTACT_SHEET_PREFIX=
IMAGE_BATCH_MIGRATE_INDEXES=
